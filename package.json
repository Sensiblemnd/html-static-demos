{
  "name": "demo1-react",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm css:watch\" \"vite\"",
    "build": "pnpm css:build && tsc -b && vite build",
    "preview": "vite preview",
    "css:build": "tailwindcss build src-tailwind/tailwind.css -c tailwind.config.cjs -o src-tailwind/tailwind.generated.css",
    "css:watch": "tailwindcss build src-tailwind/tailwind.css -c tailwind.config.cjs -o src-tailwind/tailwind.generated.css -w",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "1.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
